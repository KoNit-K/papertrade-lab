  "official_changes": [
    {
      "topic": "small-winning-moves",
      "claim": "Extra holdback for small wins; payout still rises with favorable move.",
      "support": "Prior fixed-band constants and boundary checks.",
      "remaining": "No exhaustive instrument/rounding monotonicity proof."
    },
    {
      "topic": "two-payout-curves",
      "claim": "Dedicated keeper selects standard/off-hours fixed curves.",
      "support": "Prior library constants; local guarded bool setter.",
      "remaining": "No live keeper identity, schedule or switching transaction."
    },
    {
      "topic": "close-at-bust",
      "claim": "At or beyond bust settles as hard liquidation.",
      "support": "Six local inclusive-direction comparisons.",
      "remaining": "No full oracle/signature/settlement ledger."
    },
    {
      "topic": "builder-fees",
      "claim": "Approved builder named by session key receives 0.5% of close PnL; liquidations pay none.",
      "support": "Prior approved-registry rate 5000000000000000; local liability/owner-gate checks.",
      "remaining": "Exact PnL stage/sign, rounding, addition versus carve-out and final payment."
    },
    {
      "topic": "staker-fee-push",
      "claim": "Only PaperStaking calls Exchange.pushStakerFees().",
      "support": "New caller check against configured slot 0x1f, unlike acquired older entry.",
      "remaining": "Configured role not freshly read; complete funding/allocation/withdrawal not replayed."
    },
    {
      "topic": "mint-rule",
      "claim": "Each dollar of loss basis mints a fixed share of supply, with no cap.",
      "support": "Prior enabled coefficient, getter and controlled mint-call checks.",
      "remaining": "No unbounded arithmetic or every administrative mint/burn path proof."
    },
    {
      "topic": "insolvency-bonus",
      "claim": "Deficit-refilling portion counts up to 5x toward mint.",
      "support": "Prior three-day multiplier and deficit clipping.",
      "remaining": "Not a whole-loss 5x rule or a supply cap."
    },
    {
      "topic": "governance",
      "claim": "Timelock approves builders, sets rate and moves unclaimed fees; multisig can remove immediately.",
      "support": "Retained authority checks and owner-guarded move entry.",
      "remaining": "Invented-owner fixture does not identify live role holders or query builder mappings."
    }
  ],
